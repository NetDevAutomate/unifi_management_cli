# UniFi Management CLI configuration: a template with placeholders only.
#
# Copy to ${XDG_CONFIG_HOME:-~/.config}/unifi_management_cli/prod.env, fill in your copy and
# chmod 600 it. Never commit a filled-in copy. unifi-mapper and unifi-mcp also take
# --config PATH or UNIFI_CONFIG=PATH. Format: KEY=VALUE lines, # starts a comment,
# surrounding quotes are stripped.

# ==============================================
# UniFi controller (the "controller" family: every CLI command, most MCP tools)
# ==============================================

# Controller URL (required). UniFi OS consoles answer on 443; older controllers on 8443.
UNIFI_URL=https://<console-address>

# Site name (default: "default")
UNIFI_SITE=default

# Authentication: an API token (recommended), or a local admin username and password.
# UNIFI_CONSOLE_API_TOKEN=
# UNIFI_USERNAME=
# UNIFI_PASSWORD=

# SSL verification (true/false; default false, for self-signed certificates)
UNIFI_VERIFY_SSL=false

# Request timeout in seconds (default 10, kept within 1-300)
UNIFI_TIMEOUT=10

# ==============================================
# Gateway SSH (diagnose latency-matrix, diagnose bandwidth; CLI only)
# ==============================================

# Enable SSH in UniFi OS first (Settings > Control Plane > Console). Both commands stop with
# [CONFIG_MISSING] before connecting unless UNIFI_SSH_PASSWORD is set; UNIFI_PASSWORD is
# never sent over SSH. The gateway's host key is not verified yet (issue 038).
# UNIFI_SSH_USERNAME=root
# UNIFI_SSH_PASSWORD=

# ==============================================
# Network Integration API (the "network_api" family: the six MCP network tools)
# ==============================================

# All three keys are required; with any one missing the six tools return CONFIG_MISSING.
# The key is a UniFi Network Integrations API key; the site id is the site's UUID.
# UNIFI_NETWORK_HOST=<console-address>
# UNIFI_NETWORK_API_KEY=
# UNIFI_NETWORK_SITE_ID=<site-id>
# Optional: UNIFI_NETWORK_PORT (443), UNIFI_NETWORK_VERIFY_SSL (false),
# UNIFI_NETWORK_TIMEOUT (30 s), UNIFI_NETWORK_DEBUG (false).

# ==============================================
# UniFi Protect (the "protect" family: the five MCP Protect tools)
# ==============================================

# Use a dedicated local, view-only Protect account, not the controller admin. The Protect
# tools have not been verified against a live console yet (issue 034).
# PROTECT_HOST=<console-address>
# PROTECT_USERNAME=
# PROTECT_PASSWORD=
# Optional: PROTECT_PORT (443), PROTECT_VERIFY_SSL (false), PROTECT_STORE_SESSIONS (true),
# PROTECT_CACHE_DIR, PROTECT_WS_TIMEOUT (30 s), PROTECT_MINIMUM_SCORE (0),
# PROTECT_IGNORE_UNADOPTED (true), PROTECT_DEBUG (false).

# ==============================================
# MCP server settings (optional; not read from this file)
# ==============================================

# unifi-mcp reads UNIFI_CONFIG and UNIFI_MCP_* only from its own environment, so set them
# in the MCP client's "env" block (scripts/unifi-mcp-launch.sh exports every key of its
# file, so there they work from the file too). See docs/mcp-server/MCP_SERVER_GUIDE.md.
#   UNIFI_MCP_TOOL_SURFACE=discovery     # or direct
#   UNIFI_MCP_LOG_LEVEL=WARNING          # a loguru level name
#   UNIFI_MCP_TOOL_TIMEOUT=              # seconds, 5-3600; unset = no deadline
#   UNIFI_MCP_CREDENTIAL_TIMEOUT=15      # seconds, 1-120
#   UNIFI_MCP_MAX_CONCURRENCY=4          # 1-32
#   UNIFI_MCP_REQUEST_AUDIT=             # path of a JSON-lines request audit

# ==============================================
# STP overrides (optional)
# ==============================================

# YAML file of root-eligible and forced-access switch MACs for the STP optimiser.
# Default: ~/.config/unifi_management_cli/stp_overrides.yaml
# UNIFI_STP_OVERRIDES=

# ==============================================
# ONVIF camera scripts (scripts/onvif_probe.py and scripts/onvif_stream.py only)
# ==============================================

# The CLI and the MCP server never read these. The two scripts read them from their own
# environment and stop before connecting if one is unset: keep them in a separate file outside
# the repo (chmod 600) and pass it with: uv run --env-file FILE python scripts/onvif_probe.py
# ONVIF_CAMERAS takes comma-separated NAME=HOST[:PORT] entries (port 80 when omitted).
# See docs/guides/axis-provisioning.md, section 8.
# ONVIF_USERNAME=
# ONVIF_PASSWORD=
# ONVIF_CAMERAS=

# ==============================================
# Settings with limited or no effect (issue 042)
# ==============================================

# Only the legacy `python -m unifi_mapper.cli` reads these three. unifi-mapper discover
# ignores them: it writes ./reports/port_mapping_report.md and
# ./diagrams/network_diagram.<format> (png) unless --output, --diagram or --format says otherwise.
# mermaid and dot write a one-line placeholder, not a diagram (issue 044).
# UNIFI_DEFAULT_FORMAT=png             # png, svg, html, mermaid or dot
# UNIFI_OUTPUT_DIR=
# UNIFI_DIAGRAM_DIR=
# Parsed, but no client reads them: the sync controller client keeps its built-in 3
# attempts and 1.0 s back-off.
# UNIFI_MAX_RETRIES=3
# UNIFI_RETRY_DELAY=1.0

# ==============================================
# Usage examples
# ==============================================

# With this file at ~/.config/unifi_management_cli/prod.env:
#
# 1. Discover the topology and preview port names (writes the report and diagram only):
#    unifi-mapper discover
#
# 2. Choose the diagram format:
#    unifi-mapper discover --format svg
#
# 3. Choose the output locations:
#    unifi-mapper discover --output ~/custom/report.md --diagram ~/custom/diagram.png
#
# 4. Include connected devices (still a preview):
#    unifi-mapper discover --connected-devices
#
# 5. Write the proposed port names to the controller:
#    unifi-mapper discover --apply

# ==============================================
# Security notes
# ==============================================

# 1. Set restrictive permissions:
#    chmod 600 ~/.config/unifi_management_cli/*.env
#
# 2. Never commit config files to git
#
# 3. Use API tokens instead of passwords when possible
#
# 4. Rotate tokens regularly

# ==============================================
# Where files live (XDG Base Directory specification)
# ==============================================

# - Config: ${XDG_CONFIG_HOME:-~/.config}/unifi_management_cli/ (this file)
# - State:  ${XDG_STATE_HOME:-~/.local/state}/unifi_mapper/ (link-error baseline, port
#   counter baseline and port counter history, written only by analyze link-errors
#   --snapshot or --record)
# - Radio snapshots and the config-drift, roaming and neighbour baselines are still written
#   under ./reports/ in the working directory (issue 010).
